{
  "name": "research-topic-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "build": "npm run validate:categories && npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:security": "node scripts/check-secret-leaks.mjs",
    "validate:categories": "tsx scripts/validate-category-data.ts",
    "extract:jif": "tsx scripts/extract-jif-data.ts",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "d3-force": "3.0.0",
    "lucide-react": "1.30.0",
    "mobx": "6.16.1",
    "mobx-react-lite": "3.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1",
    "vosviewer-online": "1.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
